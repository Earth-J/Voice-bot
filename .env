# Copy to .env for LOCAL use (bun run start). NEVER commit .env.
# On Railway you do not use this file — paste the variables in the service's
# "Variables" tab instead (see DEPLOY-RAILWAY.md).

# ── Discord (required) ────────────────────────────────────────
# Listener bot (joins the voice channel, transcribes, handles /earth commands)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Main guild id (fallback when a command is used from DM)
DISCORD_GUILD_ID=
# Discord user IDs allowed to use slash commands (comma-separated)
DC_OWNER_IDS=
# Music bot = a SECOND application/bot account (invite with Connect + Speak)
MUSIC_BOT_TOKEN=

# ── Speech-to-text (required) ─────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=th
GROQ_STT_PROMPT=Earth Jarvis เอิร์ธ จาร์วิส เปิดเพลง หยุดเพลง

# ── Gemini: fix mis-heard song names (optional) ───────────────
# Only the <song name> of "เปิดเพลง"/"เพิ่มเพลง" is sent to Gemini (text only, no audio).
# No key = feature off; the bot works exactly as before.
GEMINI_API_KEY=
# Backup key: used automatically when the main key hits its limit (HTTP 429) or is rejected
GEMINI_API_KEY_BACKUP=
# Gemini 1.5 Flash has been retired by Google — pick a current Flash / Flash-Lite model name
# from https://aistudio.google.com (default below)
GEMINI_MODEL=gemini-3.5-flash-lite
# Total time budget per correction; after this the original text is used (default 2500)
GEMINI_TIMEOUT_MS=8000
# How long to skip a rate-limited key (default 60000)
GEMINI_COOLDOWN_MS=60000
#GEMINI_CORRECTION=false   # switch the feature off without removing the keys
# Only these Discord user IDs are listened to (comma-separated).
# If unset, the code falls back to the ID mentioned in README.md.
LISTEN_USER_IDS=

# ── Lavalink ──────────────────────────────────────────────────
# Local docker compose: localhost:2333 — Railway: ${{lavalink.RAILWAY_PRIVATE_DOMAIN}}:2333
LAVALINK_HOST=localhost:2333
# Must equal LAVALINK_SERVER_PASSWORD of the Lavalink container
LAVALINK_PASSWORD=youshallnotpass
# "true" only when LAVALINK_HOST is behind https/wss (NOT for railway.internal)
LAVALINK_SECURE=false
# LAVALINK_SEARCH_PREFIX=ytsearch:
# Starting volume 0–1 (default 0.5)
# MUSIC_VOLUME=0.5
# Skip search results longer than this many minutes (default 20)
# MUSIC_MAX_MINUTES=20

# ── Audio pipeline (optional) ─────────────────────────────────
# SILENCE_THRESHOLD_MS=1500
# CHUNK_FLUSH_MS=8000
# MIN_FINAL_CHUNK_MS=1500
# VOICE_TMP_DIR=/tmp/voice-bot-stt

# ── Auto-leave / housekeeping (optional) ──────────────────────
# Leave this many ms after the last human leaves the channel (0 = instantly)
# ALONE_LEAVE_DELAY_MS=2000
# AUTO_LEAVE_ALONE_MS=300000
# STAY_MAX_HOURS=24
# MEMORY_REPORT_MS=600000
# Rough cost estimate in /earth status: put the $/audio-hour rate from Groq's pricing page
# GROQ_STT_USD_PER_HOUR=

# ── Docker / Railway only (optional) ──────────────────────────
# Set to true for ONE deploy to (re)register slash commands, then remove it.
# REGISTER_COMMANDS_ON_START=true
# Use a system ffmpeg instead of the bundled ffmpeg-static
# FFMPEG_PATH=/usr/bin/ffmpeg

# ── Queue (optional) ──────────────────────────────────────────
# Text channel for the live queue embed (listener bot needs View + Send Messages + Embed Links)
# QUEUE_CHANNEL_ID=954104906149687306
# Max songs waiting in the queue per server
# MUSIC_MAX_QUEUE=50
