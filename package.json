{
  "name": "voice-bot-stt",
  "version": "0.2.0",
  "type": "module",
  "description": "Discord voice bot — real-time speech-to-text via Groq Whisper; say \"earth/jarvis เปิดเพลง <ชื่อเพลง>\" to play a song from YouTube through Lavalink. Silent otherwise; nothing is recorded.",
  "scripts": {
    "register": "bun src/register-commands.ts",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "voice-test": "bun scripts/voice-test.ts",
    "postinstall": "bash scripts/fix-opus-abi.sh || true",
    "fix-opus": "bash scripts/fix-opus-abi.sh"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.0",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "shoukaku": "^4.1.1",
    "sodium-native": "^5.1.0",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "ffmpeg-static",
    "sodium-native"
  ]
}
